{"area": "intents", "title": "Payment intents", "summary": "Creates, authorises, captures and refunds card payments.",
 "configs": [{"id": "fraud.threshold", "kind": "storeSetting"}],
 "nodes": [
  {"id": "intents", "parent": null, "kind": "service", "title": "Payment intents"},
  {"id": "intents.create", "parent": "intents", "kind": "route", "title": "Create a payment",
   "http": {"method": "POST", "path": "/payments/intents"}, "fulfills": ["checkout.payment.submit"], "status": "built",
   "next": [{"to": "intents.create.fraud", "label": "screen"}]},
  {"id": "intents.create.fraud", "parent": "intents.create", "kind": "rule", "title": "Fraud screen", "status": "built",
   "when": ["fraud.threshold > 0"], "next": [{"to": "intents.create.authorize", "label": "clear"}]},
  {"id": "intents.create.authorize", "parent": "intents.create", "kind": "action", "title": "Authorise the card", "status": "built",
   "next": [{"to": "intents.ledger", "label": "record"}]},
  {"id": "intents.status", "parent": "intents", "kind": "route", "title": "Payment status",
   "http": {"method": "GET", "path": "/payments/intents/{intent}"}, "status": "built",
   "next": [{"to": "intents.ledger", "label": "read"}]},
  {"id": "intents.capture", "parent": "intents", "kind": "action", "title": "Capture the payment",
   "events": ["payment.captured"], "status": "built"},
  {"id": "intents.refund", "parent": "intents", "kind": "route", "title": "Refund a payment",
   "http": {"method": "POST", "path": "/payments/refunds"}, "status": "built",
   "next": [{"to": "intents.refund.call", "label": "refund"}]},
  {"id": "intents.refund.call", "parent": "intents.refund", "kind": "action", "title": "Ask the gateway to refund", "status": "built",
   "next": [{"to": "intents.refund.emit", "label": "done"}]},
  {"id": "intents.refund.emit", "parent": "intents.refund", "kind": "action", "title": "Announce the refund",
   "events": ["payment.refunded"], "status": "built"},
  {"id": "intents.refund.limit", "parent": "intents.refund", "kind": "invariant", "title": "Never refund more than was paid", "status": "built"},
  {"id": "intents.ledger", "parent": "intents", "kind": "data", "title": "Payment ledger", "status": "built",
   "config_source": {"type": "db", "ref": "payments", "scope": "store"}}
 ]}

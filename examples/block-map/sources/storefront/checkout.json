{"area": "checkout", "title": "Checkout", "summary": "Sign-in, address, delivery, payment and confirmation.",
 "configs": [{"id": "guest_checkout.enabled", "kind": "storeSetting"}],
 "nodes": [
  {"id": "checkout", "parent": null, "kind": "page", "title": "Checkout"},
  {"id": "checkout.signin", "parent": "checkout", "kind": "screen", "title": "Sign in or continue as guest", "status": "built",
   "next": [{"to": "checkout.signin.call", "label": "sign in"},
            {"to": "checkout.address", "label": "as guest", "when": ["guest_checkout.enabled = true"]}]},
  {"id": "checkout.signin.call", "parent": "checkout.signin", "kind": "api", "title": "Start a session",
   "api": {"method": "POST", "path": "/accounts/sessions", "variant": "ok"}, "status": "built",
   "next": [{"to": "checkout.address", "label": "signed in"}]},
  {"id": "checkout.address", "parent": "checkout", "kind": "screen", "title": "Delivery address", "status": "built",
   "next": [{"to": "checkout.address.save", "label": "save"}]},
  {"id": "checkout.address.save", "parent": "checkout.address", "kind": "api", "title": "Save the address",
   "api": {"method": "PUT", "path": "/checkout/orders/{order}/address", "variant": "ok"}, "status": "built",
   "next": [{"to": "checkout.delivery", "label": "next"}]},
  {"id": "checkout.delivery", "parent": "checkout", "kind": "screen", "title": "Delivery options", "status": "built",
   "next": [{"to": "checkout.delivery.load", "label": "load"}, {"to": "checkout.payment", "label": "choose"}]},
  {"id": "checkout.delivery.load", "parent": "checkout.delivery", "kind": "api", "title": "Load delivery options",
   "api": {"method": "GET", "path": "/checkout/delivery-options", "variant": "ok"}, "status": "built"},
  {"id": "checkout.payment", "parent": "checkout", "kind": "screen", "title": "Payment", "status": "built",
   "next": [{"to": "checkout.payment.card", "label": "pay by card"}]},
  {"id": "checkout.payment.card", "parent": "checkout.payment", "kind": "action", "title": "Card form", "status": "built",
   "next": [{"to": "checkout.payment.submit", "label": "pay"}]},
  {"id": "checkout.payment.submit", "parent": "checkout.payment", "kind": "api", "title": "Create the payment",
   "api": {"method": "POST", "path": "/payments/intents", "variant": "ok"}, "status": "built",
   "tests": {"react": ["checkout/payment.test.ts > submits the card"]},
   "next": [{"to": "checkout.payment.challenge", "label": "challenge", "when": ["payment.needs_challenge"]},
            {"to": "checkout.place", "label": "authorised"}, {"to": "checkout.failed", "label": "declined"}]},
  {"id": "checkout.payment.challenge", "parent": "checkout.payment", "kind": "action", "title": "Card challenge", "status": "built",
   "detail": "The card issuer's extra check, shown in a frame.",
   "next": [{"to": "checkout.place", "label": "passed"}, {"to": "checkout.failed", "label": "failed"}]},
  {"id": "checkout.place", "parent": "checkout", "kind": "api", "title": "Place the order",
   "api": {"method": "POST", "path": "/checkout/orders/{order}/place", "variant": "ok"}, "status": "built",
   "next": [{"to": "checkout.confirm", "label": "placed"}]},
  {"id": "checkout.confirm", "parent": "checkout", "kind": "screen", "title": "Order confirmation", "status": "built"},
  {"id": "checkout.failed", "parent": "checkout", "kind": "screen", "title": "Payment failed", "status": "built",
   "next": [{"to": "checkout.payment", "label": "try again", "loop": true}]}
 ]}

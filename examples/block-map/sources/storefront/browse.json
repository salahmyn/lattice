{"area": "browse", "title": "Browse and search", "summary": "Search results with filters, sorting and paging.",
 "configs": [{"id": "search.page_size", "kind": "storeSetting"}],
 "nodes": [
  {"id": "browse", "parent": null, "kind": "page", "title": "Browse and search"},
  {"id": "browse.results", "parent": "browse", "kind": "screen", "title": "Search results", "status": "built",
   "next": [{"to": "browse.query", "label": "query"}, {"to": "browse.open", "label": "pick a book"},
            {"to": "browse.empty", "label": "nothing found", "when": ["results = 0"]}]},
  {"id": "browse.query", "parent": "browse.results", "kind": "api", "title": "Run the search",
   "api": {"method": "GET", "path": "/catalogue/search", "variant": "ok"}, "status": "built",
   "when": ["search.page_size > 0"]},
  {"id": "browse.open", "parent": "browse.results", "kind": "action", "title": "Open a result", "status": "built",
   "next": [{"to": "book.details", "label": "open"}]},
  {"id": "browse.filters", "parent": "browse", "kind": "screen", "title": "Filters", "status": "built",
   "next": [{"to": "browse.results", "label": "apply"}]},
  {"id": "browse.filters.genre", "parent": "browse.filters", "kind": "action", "title": "Filter by genre", "status": "built"},
  {"id": "browse.filters.price", "parent": "browse.filters", "kind": "action", "title": "Filter by price", "status": "built"},
  {"id": "browse.filters.format", "parent": "browse.filters", "kind": "action", "title": "Filter by format", "status": "planned"},
  {"id": "browse.sort", "parent": "browse", "kind": "action", "title": "Sort results", "status": "built",
   "next": [{"to": "browse.results", "label": "re-sort"}]},
  {"id": "browse.page", "parent": "browse", "kind": "action", "title": "Next page", "status": "built",
   "next": [{"to": "browse.query", "label": "more"}]},
  {"id": "browse.empty", "parent": "browse", "kind": "screen", "title": "No results", "status": "built",
   "detail": "Suggests other searches when nothing matches."}
 ]}

{"area": "book", "title": "Book page", "summary": "One book: details, reviews, stock and the add-to-basket button.",
 "configs": [{"id": "reviews.enabled", "kind": "storeSetting"}],
 "nodes": [
  {"id": "book", "parent": null, "kind": "page", "title": "Book page"},
  {"id": "book.details", "parent": "book", "kind": "screen", "title": "Book details", "status": "built",
   "next": [{"to": "book.load", "label": "load"}, {"to": "book.add", "label": "add to basket"},
            {"to": "book.wishlist", "label": "save for later"}]},
  {"id": "book.load", "parent": "book.details", "kind": "api", "title": "Load the book",
   "api": {"method": "GET", "path": "/catalogue/books/{id}", "variant": "ok"}, "status": "built",
   "tests": {"react": ["book/details.test.ts > shows title and author"]}},
  {"id": "book.reviews", "parent": "book", "kind": "screen", "title": "Reviews", "status": "built",
   "when": ["reviews.enabled = true"], "next": [{"to": "book.reviews.load", "label": "load"}]},
  {"id": "book.reviews.load", "parent": "book.reviews", "kind": "api", "title": "Load reviews",
   "api": {"method": "GET", "path": "/catalogue/books/{id}/reviews", "variant": "ok"}, "status": "built"},
  {"id": "book.stock", "parent": "book", "kind": "screen", "title": "Stock badge", "status": "built",
   "next": [{"to": "book.stock.load", "label": "load"}]},
  {"id": "book.stock.load", "parent": "book.stock", "kind": "api", "title": "Load stock",
   "api": {"method": "GET", "path": "/catalogue/books/{id}/stock", "variant": "ok"}, "status": "built"},
  {"id": "book.add", "parent": "book", "kind": "action", "title": "Add to basket", "status": "built",
   "next": [{"to": "book.add.call", "label": "add"}, {"to": "cart.view", "label": "view basket"}]},
  {"id": "book.add.call", "parent": "book.add", "kind": "api", "title": "Add the book to the basket",
   "api": {"method": "POST", "path": "/checkout/basket/items", "variant": "ok"}, "status": "built",
   "tests": {"react": ["book/add.test.ts > adds one copy"]}},
  {"id": "book.wishlist", "parent": "book", "kind": "action", "title": "Save for later", "status": "built",
   "next": [{"to": "book.wishlist.call", "label": "save"}]},
  {"id": "book.wishlist.call", "parent": "book.wishlist", "kind": "api", "title": "Add to the wish list",
   "api": {"method": "POST", "path": "/accounts/wishlist", "variant": "ok"}, "status": "planned"}
 ]}

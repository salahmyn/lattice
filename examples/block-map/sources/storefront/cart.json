{"area": "cart", "title": "Basket", "summary": "The basket: quantities, vouchers and the way into checkout.",
 "configs": [{"id": "vouchers.enabled", "kind": "storeSetting"}],
 "nodes": [
  {"id": "cart", "parent": null, "kind": "page", "title": "Basket"},
  {"id": "cart.view", "parent": "cart", "kind": "screen", "title": "Basket contents", "status": "built",
   "next": [{"to": "cart.load", "label": "load"}, {"to": "cart.qty", "label": "change quantity"},
            {"to": "cart.remove", "label": "remove"}, {"to": "cart.voucher", "label": "apply voucher"},
            {"to": "cart.continue", "label": "check out", "when": ["basket.items > 0"]}]},
  {"id": "cart.load", "parent": "cart.view", "kind": "api", "title": "Load the basket",
   "api": {"method": "GET", "path": "/checkout/basket", "variant": "ok"}, "status": "built"},
  {"id": "cart.qty", "parent": "cart", "kind": "action", "title": "Change quantity", "status": "built",
   "next": [{"to": "cart.qty.call", "label": "save"}]},
  {"id": "cart.qty.call", "parent": "cart.qty", "kind": "api", "title": "Update a line",
   "api": {"method": "PATCH", "path": "/checkout/basket/items/{line}", "variant": "ok"}, "status": "built"},
  {"id": "cart.remove", "parent": "cart", "kind": "action", "title": "Remove a line", "status": "built",
   "next": [{"to": "cart.remove.call", "label": "remove"}]},
  {"id": "cart.remove.call", "parent": "cart.remove", "kind": "api", "title": "Delete a line",
   "api": {"method": "DELETE", "path": "/checkout/basket/items/{line}", "variant": "ok"}, "status": "built"},
  {"id": "cart.voucher", "parent": "cart", "kind": "action", "title": "Apply a voucher", "status": "built",
   "when": ["vouchers.enabled = true"], "next": [{"to": "cart.voucher.call", "label": "apply"}]},
  {"id": "cart.voucher.call", "parent": "cart.voucher", "kind": "api", "title": "Check the voucher",
   "api": {"method": "POST", "path": "/checkout/basket/voucher", "variant": "ok"}, "status": "built"},
  {"id": "cart.continue", "parent": "cart", "kind": "action", "title": "Go to checkout", "status": "built",
   "next": [{"to": "checkout.signin", "label": "continue"}]}
 ]}

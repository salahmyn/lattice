{"area": "orders", "title": "Order service", "summary": "Turns a paid basket into an order and keeps its history.",
 "nodes": [
  {"id": "orders", "parent": null, "kind": "service", "title": "Order service"},
  {"id": "orders.list", "parent": "orders", "kind": "route", "title": "List orders",
   "http": {"method": "GET", "path": "/checkout/orders"}, "fulfills": ["account.orders.load"], "status": "built",
   "next": [{"to": "orders.store", "label": "read"}]},
  {"id": "orders.address", "parent": "orders", "kind": "route", "title": "Set the address",
   "http": {"method": "PUT", "path": "/checkout/orders/{order}/address"}, "fulfills": ["checkout.address.save"], "status": "built",
   "next": [{"to": "orders.store", "label": "save"}]},
  {"id": "orders.delivery", "parent": "orders", "kind": "route", "title": "Delivery options",
   "http": {"method": "GET", "path": "/checkout/delivery-options"}, "fulfills": ["checkout.delivery.load"], "status": "built",
   "next": [{"to": "orders.delivery.quote", "label": "quote"}]},
  {"id": "orders.delivery.quote", "parent": "orders.delivery", "kind": "action", "title": "Ask the carrier for rates", "status": "built"},
  {"id": "orders.place", "parent": "orders", "kind": "route", "title": "Place an order",
   "http": {"method": "POST", "path": "/checkout/orders/{order}/place"}, "fulfills": ["checkout.place"], "status": "built",
   "next": [{"to": "orders.place.validate", "label": "check"}]},
  {"id": "orders.place.validate", "parent": "orders.place", "kind": "invariant", "title": "Only a paid basket becomes an order",
   "status": "built", "next": [{"to": "orders.place.reserve", "label": "paid"}]},
  {"id": "orders.place.reserve", "parent": "orders.place", "kind": "action", "title": "Reserve the stock", "status": "built",
   "next": [{"to": "orders.place.save", "label": "reserved"}]},
  {"id": "orders.place.save", "parent": "orders.place", "kind": "action", "title": "Record the order", "status": "built",
   "next": [{"to": "orders.store", "label": "write"}, {"to": "orders.place.emit", "label": "announce"}]},
  {"id": "orders.place.emit", "parent": "orders.place", "kind": "action", "title": "Announce the order",
   "events": ["order.placed"], "status": "built"},
  {"id": "orders.cancel", "parent": "orders", "kind": "route", "title": "Cancel an order",
   "http": {"method": "POST", "path": "/checkout/orders/{order}/cancel"}, "fulfills": ["account.orders.cancel"], "status": "built",
   "next": [{"to": "orders.cancel.release", "label": "release stock"}]},
  {"id": "orders.cancel.release", "parent": "orders.cancel", "kind": "action", "title": "Give the stock back",
   "events": ["order.cancelled"], "status": "built"},
  {"id": "orders.settle", "parent": "orders", "kind": "action", "title": "Mark the order paid", "status": "built",
   "next": [{"to": "orders.store", "label": "write"}]},
  {"id": "orders.refund", "parent": "orders", "kind": "action", "title": "Mark the order refunded", "status": "planned",
   "next": [{"to": "orders.store", "label": "write"}]},
  {"id": "orders.store", "parent": "orders", "kind": "data", "title": "Order store", "status": "built",
   "config_source": {"type": "db", "ref": "orders", "scope": "store"}}
 ]}

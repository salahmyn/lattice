{"area": "basket", "title": "Basket service", "summary": "Keeps each reader's basket and prices it.",
 "configs": [{"id": "vouchers.enabled", "kind": "storeSetting"}],
 "nodes": [
  {"id": "basket", "parent": null, "kind": "service", "title": "Basket service"},
  {"id": "basket.get", "parent": "basket", "kind": "route", "title": "Get the basket",
   "http": {"method": "GET", "path": "/checkout/basket"}, "fulfills": ["cart.load"], "status": "built",
   "next": [{"to": "basket.price", "label": "price"}]},
  {"id": "basket.add", "parent": "basket", "kind": "route", "title": "Add a line",
   "http": {"method": "POST", "path": "/checkout/basket/items"}, "fulfills": ["book.add.call"], "status": "built",
   "next": [{"to": "basket.store", "label": "save"}, {"to": "basket.price", "label": "re-price"}]},
  {"id": "basket.update", "parent": "basket", "kind": "route", "title": "Change a line",
   "http": {"method": "PATCH", "path": "/checkout/basket/items/{line}"}, "fulfills": ["cart.qty.call"], "status": "built",
   "next": [{"to": "basket.store", "label": "save"}]},
  {"id": "basket.remove", "parent": "basket", "kind": "route", "title": "Remove a line",
   "http": {"method": "DELETE", "path": "/checkout/basket/items/{line}"}, "fulfills": ["cart.remove.call"], "status": "built",
   "next": [{"to": "basket.store", "label": "save"}]},
  {"id": "basket.voucher", "parent": "basket", "kind": "route", "title": "Apply a voucher",
   "http": {"method": "POST", "path": "/checkout/basket/voucher"}, "fulfills": ["cart.voucher.call"], "status": "built",
   "next": [{"to": "basket.voucher.rules", "label": "check"}]},
  {"id": "basket.voucher.rules", "parent": "basket.voucher", "kind": "rule", "title": "One voucher per basket",
   "when": ["vouchers.enabled = true"], "status": "built"},
  {"id": "basket.price", "parent": "basket", "kind": "service", "title": "Price the basket", "status": "built",
   "next": [{"to": "basket.price.tax", "label": "add tax"}]},
  {"id": "basket.price.tax", "parent": "basket.price", "kind": "rule", "title": "Tax by delivery country", "status": "built",
   "config_source": {"type": "db", "ref": "tax_rates", "scope": "store"}},
  {"id": "basket.store", "parent": "basket", "kind": "data", "title": "Basket store", "status": "built",
   "config_source": {"type": "db", "ref": "baskets", "scope": "reader"}}
 ]}
